# ZentrixPay MCP server
ZENTRIXPAY_URL=https://your-server.example.com

# Select deployment network: testnet (default) or mainnet
STELLAR_NETWORK=testnet

# Optional overrides (defaults come from STELLAR_NETWORK preset)
# NETWORK=stellar:testnet
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org
# USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
VAULT_REGISTRY_CONTRACT_ID=CDQKUIADLO5S5WEHEUTTXX2M45WAHVRU2PBEBD6ZGDKMOP5A72FJ3OD4

SPONSORED_ACCOUNT_URL=https://stellar-sponsored-agent-account.onrender.com

# Opt-in tool-level metrics (call/error counts, durations, payment attempts).
# Disabled unless set to 1/true/yes/on. Query with the zentrixpay_metrics tool
# (format arg: json or otlp).
# ZENTRIXPAY_METRICS=1

# Mirror tool-level metrics to stderr as OTLP/JSON on every tool call. Useful
# for feeding a log scraper or OpenTelemetry collector. Only active when
# ZENTRIXPAY_METRICS is also enabled.
# ZENTRIXPAY_METRICS_EXPORT_CONSOLE=1

# Platform wallet address shown by zentrixpay_wallet_balances. When set, its
# XLM/USDC balances are reported alongside the configured agent wallet(s).
# PLATFORM_WALLET_ADDRESS=GA6H...

# Read-only mode: restrict this server to catalog browsing. Only tools that
# declare readOnlyHint are advertised in tools/list, and every other tool is
# refused at dispatch. Set on the process — no tool argument can override it.
# ZENTRIXPAY_READ_ONLY=1

# Require explicit confirmPaid: true before a tool spends from the agent wallet,
# regardless of network or amount. off (default) | usdc (publish, buy) | all
# (also the on-chain mutations, which spend network fees). Dry runs are never
# gated. An unrecognized value is an error, not a silent fallback.
# ZENTRIXPAY_CONFIRM_PAID_OPERATIONS=usdc

# Custom User-Agent sent on every outbound HTTP request (ZentrixPay API, Horizon,
# Soroban RPC, sponsored-account service). Useful when you want to identify a
# specific agent or deployment in server logs. Defaults to "zentrixpay-mcp/1.0.0".
# ZENTRIXPAY_USER_AGENT=zentrixpay-mcp/1.0.0

# Request timeouts in milliseconds. Every outbound call runs under an
# AbortController using one of these budgets. Set a value to 0 to disable that
# deadline. See docs/mcp-timeouts-retries.md.
# ZENTRIXPAY_HTTP_TIMEOUT_MS=15000       # ZentrixPay API + sponsored-account service
# ZENTRIXPAY_HORIZON_TIMEOUT_MS=15000    # Horizon balance/account reads
# ZENTRIXPAY_SOROBAN_TIMEOUT_MS=20000    # Soroban RPC
# ZENTRIXPAY_PAYMENT_TIMEOUT_MS=45000    # x402 paid fetches (includes settlement)

# Catalog resource preview size limits. zentrixpay_preview caps publisher-supplied
# title/description text and keeps the whole JSON response inside a byte budget,
# so one oversized listing cannot flood an agent's context. Set either to 0 to
# disable that limit. See docs/environment-variables.md.
# ZENTRIXPAY_PREVIEW_MAX_BYTES=8192          # whole serialized preview
# ZENTRIXPAY_PREVIEW_FIELD_MAX_CHARS=1000    # per free-text field

# Retry with jittered exponential backoff for idempotent calls only (catalog
# GETs, Horizon reads, Soroban getTransaction). Payments are never retried.
# Set attempts to 1 to disable. See docs/mcp-timeouts-retries.md.
# ZENTRIXPAY_RETRY_ATTEMPTS=3
# ZENTRIXPAY_RETRY_BASE_DELAY_MS=250
# ZENTRIXPAY_RETRY_MAX_DELAY_MS=4000

# ── Mainnet example ──────────────────────────────────────────────────────────
# STELLAR_NETWORK=mainnet
# NETWORK=stellar:pubnet
# SOROBAN_RPC_URL=https://soroban.stellar.org
# HORIZON_URL=https://horizon.stellar.org
# USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# VAULT_REGISTRY_CONTRACT_ID=C...   # Required on mainnet
