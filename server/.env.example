# Server
PORT=4021
BASE_URL=http://localhost:4021
WEB_APP_URL=http://localhost:5173
# Comma-separated browser origins allowed in production (defaults to WEB_APP_URL)
# ALLOWED_ORIGINS=https://your-web-app.example.com,http://localhost:5173

# Stellar / x402
# Select deployment network: testnet (default) or mainnet. Individual vars below may override presets.
STELLAR_NETWORK=testnet
NETWORK=stellar:testnet
FACILITATOR_URL=https://www.x402.org/facilitator
# /health/ready checks GET ${FACILITATOR_URL}/supported (read-only, no payment) (#133).
# FACILITATOR_HEALTH_TIMEOUT_MS=2000
# READINESS_REQUIRE_FACILITATOR=true
# Soroban USDC SAC for the selected network (auto-filled from STELLAR_NETWORK if omitted)
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org   # Stellar testnet Soroban RPC

# Soroban registry (APIs are registered on-chain here)
REGISTRY_CONTRACT_ID=CDQKUIADLO5S5WEHEUTTXX2M45WAHVRU2PBEBD6ZGDKMOP5A72FJ3OD4   # Deployed registry on testnet (see contract/README.md)
REGISTRY_SECRET_KEY=S...                 # Secret key of the registry deployer / owner account

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Limits
# Explicit body limit for express.json() (e.g. 1mb, 512kb).
MAX_JSON_BODY_SIZE=1mb

# Rate limiting (API publishing and publisher registration)
RATE_LIMIT_PUBLISH_IP_MAX=20
RATE_LIMIT_PUBLISH_IP_WINDOW_MS=60000
RATE_LIMIT_PUBLISH_WALLET_MAX=10
RATE_LIMIT_PUBLISH_WALLET_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_IP_MAX=5
RATE_LIMIT_REGISTER_IP_WINDOW_MS=3600000

# Optional Redis URL for shared sliding-window rate limits across instances
# REDIS_URL=redis://localhost:6379

# Optional HMAC request signatures for publisher mutations
# REQUIRE_REQUEST_SIGNATURE=false
# SIGNATURE_MAX_SKEW_MS=300000

# Resilience
REQUEST_TIMEOUT_MS=30000              # Per-request timeout; slow upstreams return 503
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000    # Max drain time for in-flight requests on shutdown
IDEMPOTENCY_TTL_MS=86400000           # How long an Idempotency-Key is remembered (24h)

# Metrics endpoint token (optional — /metrics is disabled when unset)
# METRICS_TOKEN=

# Sentry error tracking (optional — errors only report when DSN is set)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ── Mainnet example (uncomment and replace placeholders) ─────────────────────
# STELLAR_NETWORK=mainnet
# NETWORK=stellar:pubnet
# SOROBAN_RPC_URL=https://soroban.stellar.org
# USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# REGISTRY_CONTRACT_ID=C...                # Your mainnet registry deployment
# REGISTRY_SECRET_KEY=S...                 # Mainnet registry owner secret

# ── Pay-per-call API proxy ───────────────────────────────────────────────────
# 64 hex chars; encrypts providers' upstream secret headers. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPSTREAM_SECRET_KEY=
# PROXY_MAX_REQUEST_BODY=5mb
# PROXY_MAX_RESPONSE_BYTES=10485760
# PROXY_DEFAULT_TIMEOUT_MS=15000
# PROXY_MAX_TIMEOUT_MS=25000
# PROXY_IDEMPOTENCY_TTL_MS=3600000
# PROXY_IDEMPOTENCY_MAX_ENTRIES=1000
# PROXY_IDEMPOTENCY_MAX_BODY_BYTES=262144
# Local development only — lets upstreams live on localhost/private networks.
# PROXY_ALLOW_PRIVATE_UPSTREAMS=false
# How long a proxied API's row is cached (edits invalidate it immediately).
# PROXY_API_CACHE_TTL_MS=5000
# Upstream health checks for APIs with a healthPath (0 disables the job).
# HEALTH_CHECK_INTERVAL_MS=60000
# HEALTH_CHECK_TIMEOUT_MS=5000
# HEALTH_CHECK_FAILURE_THRESHOLD=3
# Provider webhooks for charged calls.
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_RETRY_BASE_MS=1000
# Retention of API call records (docs/api-call-retention.md). Rows older than
# API_CALL_RETENTION_DAYS are deleted; 0 keeps them forever, otherwise >= 90.
# API_CALL_RETENTION_DAYS=180
# API_CALL_RETENTION_INTERVAL_MS=3600000
# API_CALL_RETENTION_BATCH_SIZE=1000

# Failed api_calls inserts are spooled here and retried in the background (#134).
# Use a persistent volume in production so spooled rows survive restarts.
# API_CALL_OUTBOX_DIR=./data/api-call-outbox
# API_CALL_RECOVERY_INTERVAL_MS=30000
# Set false on API-only instances so background workers do not run here (#207).
# RUN_BACKGROUND_WORKERS=true
